{
  "agent": {
    "metrics_collection_interval": 60
  },

  "metrics": {
    "namespace": "InnGrid/Frontend",

    "metrics_collected": {

      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_user",
          "cpu_usage_system"
        ],

        "totalcpu": true
      },

      "mem": {
        "measurement": [
          "mem_used_percent"
        ]
      },

      "disk": {
        "measurement": [
          "used_percent"
        ],

        "resources": [
          "/"
        ]
      }
    }
  }
}